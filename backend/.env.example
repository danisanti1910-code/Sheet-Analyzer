# =============================================================================
# Variables de entorno del BACKEND. Copia a backend/.env o .env en la raíz.
# NUNCA subas .env al repositorio.
# =============================================================================
#
# MongoDB: la URI debe incluir w=majority en la query string (no w=Cluster0).
# Ejemplo (una sola línea, sin comillas, sin espacios alrededor del =):
#
# MONGODB_URI=mongodb+srv://USER:PASSWORD@HOST/DB?retryWrites=true&w=majority
#
# =============================================================================

MONGODB_URI=

# PORT=3000
FRONTEND_URL=
SUPER_ADMIN_EMAIL=

# Stripe (Pasarela de pagos)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_PRICE_ID=
STRIPE_BUSINESS_PRICE_ID=
VITE_STRIPE_PUBLISHABLE_KEY=

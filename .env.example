# =============================================================================
# Ejemplo de variables de entorno. Copia a .env y rellena los valores.
# Este archivo SÍ se puede subir al repo (no contiene secretos).
# =============================================================================

# MongoDB Atlas: Cluster → Connect → Connect your application.
# La URI debe usar w=majority en la query string (no w=Cluster0).
# Ejemplo: MONGODB_URI=mongodb+srv://USER:PASSWORD@HOST/DB?retryWrites=true&w=majority
# (una línea, sin comillas, sin espacios alrededor del =)
MONGODB_URI=

# Opcional
# DATABASE_URL=

# Backend (en Render: pon aquí la URL de tu front, p. ej. https://tu-app.vercel.app)
# PORT=3000
FRONTEND_URL=
SUPER_ADMIN_EMAIL=

# Frontend: URL del backend (p. ej. https://tu-backend.onrender.com). Sin barra final.
# Si no se define, en producción el front usa la URL por defecto del backend.
VITE_API_URL=

# =============================================================================
# SMTP (Correo electrónico – verificación de cuenta y recuperación de contraseña)
# =============================================================================
# Cualquier proveedor SMTP funciona: Gmail, SendGrid, Mailgun, Amazon SES, etc.
# Si no se configuran, los correos se imprimen en la consola del servidor (modo dev).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Sheet Analyzer <noreply@tudominio.com>"
# URL pública de la app (para generar enlaces en los correos)
APP_URL=

# =============================================================================
# Stripe (Pasarela de pagos / suscripciones)
# =============================================================================
# Clave secreta de Stripe (empieza con sk_test_ o sk_live_)
STRIPE_SECRET_KEY=
# Secreto del webhook de Stripe (empieza con whsec_)
STRIPE_WEBHOOK_SECRET=
# IDs de precios creados en Stripe Dashboard (Productos → Precio → Copiar API ID)
STRIPE_PRO_PRICE_ID=
STRIPE_BUSINESS_PRICE_ID=
# Clave publicable de Stripe (empieza con pk_test_ o pk_live_) — también se usa en el frontend
VITE_STRIPE_PUBLISHABLE_KEY=

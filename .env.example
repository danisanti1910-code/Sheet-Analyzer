# =============================================================================
# Ejemplo de variables de entorno. Copia a .env y rellena los valores.
# Este archivo SÍ se puede subir al repo (no contiene secretos).
# =============================================================================

# MongoDB Atlas: Cluster → Connect → Connect your application
MONGODB_URI=

# Opcional
# DATABASE_URL=

# Backend (en Render: pon aquí la URL de tu front, p. ej. https://tu-app.vercel.app)
# PORT=5000
FRONTEND_URL=
SUPER_ADMIN_EMAIL=

# Frontend: URL del backend (p. ej. Render). Sin barra final.
# Si no se define, en producción el front usa https://sheet-analyzer-qu7k.onrender.com
VITE_API_URL=https://sheet-analyzer-qu7k.onrender.com
